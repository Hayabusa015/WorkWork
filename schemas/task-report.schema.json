{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hayabusa015/WorkWork/schemas/task-report.schema.json",
  "title": "SHULL OS Task Report",
  "description": "The completion report for a document-producing task. WORK COMPLETE requires every required step accounted for AND a verified location. See workflows/build-deliverable.md.",
  "type": "object",
  "required": ["task", "subject", "deliverable", "steps", "status"],
  "additionalProperties": false,
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "subject": { "enum": ["Chemistry", "Physics", "Geology"] },
    "unit": { "type": "string", "pattern": "^U\\d{2}$" },
    "section": { "type": "string", "pattern": "^S\\d{2}\\.\\d$" },
    "deliverable": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "object",
      "description": "Every step is pass, fail, or explicitly not required. A tick that did not happen is a lie in a form that looks like diligence.",
      "required": ["overseer", "designer", "auditor", "librarian", "deployment"],
      "additionalProperties": false,
      "properties": {
        "overseer":   { "$ref": "#/$defs/step" },
        "researcher": { "$ref": "#/$defs/step" },
        "designer":   { "$ref": "#/$defs/step" },
        "auditor":    { "$ref": "#/$defs/step" },
        "librarian":  { "$ref": "#/$defs/step" },
        "deployment": { "$ref": "#/$defs/step" }
      }
    },
    "status": { "enum": ["WORK COMPLETE", "INCOMPLETE"] },
    "location": {
      "type": "object",
      "description": "Required for WORK COMPLETE. verifiedBy records HOW the destination was confirmed - an independent lookup, not the create call returning success.",
      "required": ["path", "fileId", "verifiedBy"],
      "properties": {
        "path": { "type": "string" },
        "fileId": { "type": "string" },
        "verifiedBy": { "enum": ["parentId lookup", "get_file_metadata"] }
      }
    },
    "outstanding": {
      "type": "array",
      "description": "Required for INCOMPLETE. What failed and what remains.",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": { "enum": ["pass", "fail", "not required"] },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "not required" } }, "required": ["result"] },
          "then": { "required": ["result", "note"] }
        },
        {
          "if": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
          "then": { "required": ["result", "note"] }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "WORK COMPLETE" } }, "required": ["status"] },
      "then": { "required": ["location"] }
    },
    {
      "if": { "properties": { "status": { "const": "INCOMPLETE" } }, "required": ["status"] },
      "then": { "required": ["outstanding"] }
    }
  ]
}
