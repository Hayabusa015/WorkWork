    {
      "code": "5.4",
      "title": "Molecular Polarity",
      "learningTarget": "I can decide whether a molecule is polar by checking its bonds and its shape.",
      "pages": [
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slides 20–21 · Bond vs. molecular polarity",
              "cues": [
                "S05.4"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "A molecule with polar bonds can",
                  "answer": "still be nonpolar",
                  "inline": true
                },
                {
                  "prompt": "Bond polarity (one bond)",
                  "answer": "compare the atoms’ EN values",
                  "inline": true
                },
                {
                  "prompt": "Molecular polarity (whole molecule)",
                  "answer": "check whether the bond pulls cancel",
                  "inline": true
                },
                {
                  "prompt": "HCl",
                  "answer": "one polar bond → polar molecule",
                  "inline": true
                },
                {
                  "prompt": "CO₂",
                  "answer": "equal, opposite pulls → nonpolar",
                  "inline": true
                },
                {
                  "prompt": "To find molecular polarity, check",
                  "answer": "the bonds AND the shape",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 21 · Draw HCl and CO₂ with their dipole arrows",
                "workHeightIn": 1.7,
                "solution": [
                  "H–Cl: arrow toward Cl, crossed end at H. H δ+, Cl δ−.",
                  "O=C=O: two arrows from C toward each O, equal and opposite, so they cancel."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s21_hcl_co2.png"
              }
            },
            {
              "kind": "example",
              "title": "Slide 22 · Canceling bond dipoles",
              "cues": [
                "S05.4"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Bond pulls cancel when",
                  "answer": "their directions balance",
                  "inline": true
                },
                {
                  "prompt": "Balanced pulls → nonpolar",
                  "answer": "CO₂, BF₃, CH₄, CCl₄",
                  "inline": true
                },
                {
                  "prompt": "Pulls do not cancel → polar",
                  "answer": "H₂O, NH₃, HCl, CH₃Cl",
                  "inline": true
                },
                {
                  "prompt": "Before deciding, check",
                  "answer": "the 3D shape and the outer atoms",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 22 · Draw BF₃ and NH₃ with their dipole arrows",
                "workHeightIn": 1.7,
                "solution": [
                  "BF₃: three B–F arrows toward each F, spread evenly around B; they cancel.",
                  "NH₃: three N–H arrows toward N; the pyramid leaves a net pull toward N."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s22_bf3_nh3.png"
              }
            }
          ]
        },
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slide 23 · Molecular polarity: H₂O",
              "cues": [
                "S05.4",
                "Draw it, check the bonds, then check the shape."
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
