              "cues": [
                "S04.6"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Dipole arrow points toward",
                  "answer": "the atom pulling harder",
                  "inline": true
                },
                {
                  "prompt": "Nonpolar bond",
                  "answer": "equal or nearly equal sharing (H–H, Cl–Cl, C–H)",
                  "inline": true
                },
                {
                  "prompt": "Polar bond",
                  "answer": "unequal sharing; electrons closer to the higher-EN atom",
                  "inline": true
                },
                {
                  "prompt": "Polar examples",
                  "answer": "H–Cl, O–H, C–O",
                  "inline": true
                },
                {
                  "prompt": "δ− and δ+",
                  "answer": "partly negative; partly positive (crossed end of the arrow)",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 8 · Draw H–H and H–Cl. Add the dipole arrow, δ+ and δ− to the polar bond.",
                "workHeightIn": 1.8,
                "solution": [
                  "H–H: no arrow; equal sharing.",
                  "H–Cl: arrow points toward Cl; crossed end at H. H is δ+, Cl is δ−."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s08_dipole.png"
              }
            },
            {
              "title": "Slide 9 · Bond types at a glance",
              "cues": [
                "S04.6",
                "Compare how the electrons are shared or transferred."
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "Ionic bonds, usually",
                  "answer": "metal + nonmetal",
                  "inline": true
                },
                {
                  "prompt": "Covalent bonds, usually",
                  "answer": "nonmetal + nonmetal",
                  "inline": true
                }
              ],
