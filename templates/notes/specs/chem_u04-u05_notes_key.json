    {
      "code": "4.1",
      "title": "Why Atoms Bond & Ionic Bonding",
      "learningTarget": "I can define a chemical bond, state the octet rule, and describe ionic bonding.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slides 1–3 · Why atoms bond",
              "cues": [
                "S04.1"
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "Three ideas",
                  "answer": "bonding, molecular structure, intermolecular forces",
                  "inline": true
                },
                {
                  "prompt": "The unit",
                  "answer": "draw the electrons → find the shape → explain the properties",
                  "inline": true
                },
                {
                  "prompt": "Atoms bond when",
                  "answer": "the bonded arrangement has lower energy",
                  "inline": true
                },
                {
                  "prompt": "Chemical bond",
                  "answer": "an attraction that holds atoms or ions together",
                  "inline": true
                },
                {
                  "prompt": "Octet rule",
                  "answer": "many atoms bond with 8 outer electrons (H needs only 2)",
                  "inline": true
                },
                {
                  "prompt": "The octet rule is",
                  "answer": "a guide; some atoms are exceptions",
                  "inline": true
                }
              ],
              "notesFirst": true
            },
            {
              "kind": "example",
              "title": "Slide 4 · Ionic bonding",
              "cues": [
                "S04.2"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Ionic bonding",
                  "answer": "electrons transfer; opposite ions attract",
                  "inline": true
                },
                {
                  "prompt": "Usually between",
                  "answer": "a metal and a nonmetal",
                  "inline": true
                },
                {
                  "prompt": "Properties",
                  "answer": "hard and brittle, high melting points",
                  "inline": true
                },
                {
                  "prompt": "Ions form",
                  "answer": "a repeating crystal",
                  "inline": true
                },
                {
                  "prompt": "Conducts",
                  "answer": "when molten or dissolved, not as a solid",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 4 · Na and Cl: show the electron transfer and the two ions it makes",
                "workHeightIn": 1.6,
                "solution": [
                  "Na loses one electron → Na+",
                  "Cl gains that electron → Cl−",
                  "The opposite ions attract."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s04_ionic.png"
              }
            }
          ]
        }
      ]
    },
    {
      "code": "4.3",
      "title": "Covalent Bonding & Electronegativity",
      "learningTarget": "I can describe covalent bonding and classify a bond from its EN difference.",
      "pages": [
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slide 5 · Covalent bonding",
              "cues": [
                "S04.3"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Covalent bonding",
                  "answer": "atoms share pairs of electrons",
                  "inline": true
                },
                {
                  "prompt": "Usually between",
                  "answer": "nonmetals",
                  "inline": true
                },
                {
                  "prompt": "One bond",
                  "answer": "one shared pair of electrons",
                  "inline": true
                },
                {
                  "prompt": "Properties",
                  "answer": "often low melting points; usually poor conductors",
                  "inline": true
                },
                {
                  "prompt": "Found as",
                  "answer": "gases, liquids, or soft solids",
                  "inline": true
                },
                {
                  "prompt": "Exception",
                  "answer": "network solids (diamond): strong bonds throughout",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 5 · H and O: show the shared pairs that make H₂O",
                "workHeightIn": 1.5,
                "solution": [
                  "O shares one pair with each H.",
                  "O: 2 shared + 2 lone pairs = 8.",
                  "Each H: 1 shared pair = 2."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s05_covalent.png"
              }
            },
            {
              "title": "Slide 6 · EN and bond type",
              "cues": [
                "S04.5",
                "The cutoffs are class guidelines, not sharp boundaries."
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "Electronegativity",
                  "answer": "how strongly an atom pulls on shared electrons",
                  "inline": true
                },
                {
                  "prompt": "ΔEN",
                  "answer": "higher EN − lower EN",
                  "inline": true
                }
              ],
              "notesFirst": true,
              "table": {
                "headers": [
                  "Bond type",
                  "ΔEN",
                  "Sharing"
                ],
                "widths": [
                  0.34,
                  0.26,
                  0.4
                ],
                "rowHeightIn": 0.3,
                "rows": [
                  [
                    "Nonpolar covalent",
                    "Under 0.40",
                    "Nearly equal sharing"
                  ],
                  [
                    "Polar covalent",
                    "0.40–1.80",
                    "Unequal sharing"
                  ],
                  [
                    "Ionic",
                    "Over 1.80",
                    "Opposite ions attract"
                  ]
                ]
              }
            },
            {
              "kind": "example",
              "title": "Slide 7 · Classifying bonds",
              "cues": [
                "S04.5",
                "Subtract the EN values. Match the difference to a bond type."
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Bigger EN difference",
                  "answer": "more uneven electron sharing",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 7 · EN: H 2.20, C 2.55, O 3.44, Na 0.93, Cl 3.16. Find ΔEN and the bond type for C–H, C–O and Na–Cl.",
                "workHeightIn": 1.6,
                "solution": [
                  "C–H: 2.55 − 2.20 = 0.35; 0.35 < 0.40 → nonpolar covalent",
                  "C–O: 3.44 − 2.55 = 0.89; 0.40 ≤ 0.89 ≤ 1.80 → polar covalent",
                  "Na–Cl: 3.16 − 0.93 = 2.23; 2.23 > 1.80 → ionic"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "code": "4.6",
      "title": "Bond Polarity",
      "learningTarget": "I can draw a dipole arrow on a polar bond and label its δ+ and δ− ends.",
      "pages": [
