                "widths": [
                  0.34,
                  0.26,
                  0.4
                ],
                "rowHeightIn": 0.34,
                "rows": [
                  [
                    "Nonpolar covalent",
                    "Under 0.40",
                    "Nearly equal sharing"
                  ],
                  [
                    "Polar covalent",
                    "0.40–1.80",
                    "Unequal sharing"
                  ],
                  [
                    "Ionic",
                    "Over 1.80",
                    "Opposite ions attract"
                  ]
                ]
              },
              "notes": [
                {
                  "prompt": "These cutoffs are class",
                  "answer": "guidelines, not sharp boundaries."
                }
              ]
            },
            {
              "kind": "example",
              "title": "Slide 7 · Example: classifying bonds",
              "cues": [
                "Subtract the EN values",
                "Match the difference to a bond type"
              ],
              "problem": {
                "given": [
                  "C–H: C 2.55, H 2.20",
                  "C–O: O 3.44, C 2.55",
                  "Na–Cl: Cl 3.16, Na 0.93"
                ],
                "find": "ΔEN and bond type for each bond.",
                "answer": "C–H nonpolar covalent   C–O polar covalent   Na–Cl ionic",
                "solution": [
                  "C–H: 2.55 − 2.20 = 0.35; 0.35 < 0.40 → nonpolar covalent",
                  "C–O: 3.44 − 2.55 = 0.89; 0.40 ≤ 0.89 ≤ 1.80 → polar covalent",
                  "Na–Cl: 3.16 − 0.93 = 2.23; 2.23 > 1.80 → ionic"
                ],
                "workHeightIn": 1.6,
                "workLabel": "Show the subtraction for each bond"
              },
              "notes": [
                {
                  "prompt": "Bigger EN difference =",
                  "answer": "more uneven electron sharing"
                }
              ]
            }
          ]
        }
      ]
    },
