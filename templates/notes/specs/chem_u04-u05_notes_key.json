      "code": "4.1",
      "title": "Why Atoms Bond",
      "learningTarget": "I can define a chemical bond and state the octet rule.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slides 1–2 · Unit overview",
              "cues": [
                "Three ideas for this unit"
              ],
              "notes": [
                {
                  "prompt": "01 Bonding: electrons are",
                  "answer": "transferred or shared"
                },
                {
                  "prompt": "02 Molecular structure: the way",
                  "answer": "the atoms are arranged"
                },
                {
                  "prompt": "03 Intermolecular forces: the way",
                  "answer": "separate molecules attract each other"
                },
                {
                  "prompt": "The unit in one line: draw the electrons →",
                  "answer": "find the shape → explain the properties"
                }
              ]
            },
            {
              "title": "Slide 3 · Why atoms bond",
              "cues": [
                "Definition: chemical bond",
                "The octet rule"
              ],
              "notes": [
                {
                  "prompt": "Atoms bond when the bonded arrangement has",
                  "answer": "lower energy"
                },
                {
                  "prompt": "Chemical bond:",
                  "answer": "an attraction that holds atoms or ions together."
                },
                {
                  "prompt": "The octet rule: many atoms bond with",
                  "answer": "8 outer electrons around them"
                },
                {
                  "prompt": "Hydrogen needs only",
                  "answer": "2"
                },
                {
                  "prompt": "Neon:",
                  "answer": "8 outer electrons"
                },
                {
                  "prompt": "The octet rule is a",
                  "answer": "guide. Some atoms are exceptions."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "code": "4.2",
      "title": "Ionic Bonding",
      "learningTarget": "I can describe ionic bonding as electron transfer between a metal and a nonmetal.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slide 4 · Ionic bonding",
              "cues": [
                "The bonding partners",
                "The electron transfer",
                "Properties"
              ],
              "notes": [
                {
                  "prompt": "Ionic bonding: electrons",
                  "answer": "transfer. Opposite ions attract."
                },
                {
                  "prompt": "The bonding partners: usually",
                  "answer": "a metal and a nonmetal"
                },
                {
                  "prompt": "Na",
                  "answer": "loses an electron → Na+"
                },
                {
                  "prompt": "Cl",
                  "answer": "gains an electron → Cl−"
                },
                {
                  "prompt": "Property:",
                  "answer": "hard and brittle"
                },
                {
                  "prompt": "Property:",
                  "answer": "high melting points"
                },
                {
                  "prompt": "Ions form a",
                  "answer": "repeating crystal"
                },
                {
                  "prompt": "Conducts when",
                  "answer": "molten or dissolved, but not as a solid"
                }
              ]
            },
            {
              "kind": "example",
              "title": "Slide 4 · Example: Na and Cl",
              "cues": [
                "Electron transfer"
              ],
              "problem": {
                "given": "Sodium (Na) and chlorine (Cl).",
                "find": "the electron transfer and the two ions it makes.",
                "answer": "Ions formed: Na+ and Cl−",
                "solution": [
                  "Na loses one electron → Na+",
                  "Cl gains that electron → Cl−",
                  "The opposite ions attract."
                ],
                "workHeightIn": 1.6,
                "workLabel": "Draw it as shown on the slide"
              },
              "notes": []
            }
          ]
        }
