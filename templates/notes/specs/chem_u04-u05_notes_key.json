    {
      "code": "5.1",
      "title": "Lewis Electron Structures",
      "learningTarget": "I can draw a Lewis structure by counting, connecting, filling, and checking electrons.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slide 12 · Drawing Lewis structures",
              "cues": [
                "The four steps, in order"
              ],
              "noWorkBox": true,
              "table": {
                "headers": [
                  "Step",
                  "What to do"
                ],
                "widths": [
                  0.18,
                  0.82
                ],
                "rowHeightIn": 0.52,
                "rows": [
                  [
                    "1  Count",
                    "Add valence electrons. − charge: add electrons. + charge: subtract electrons."
                  ],
                  [
                    "2  Connect",
                    "Center: usually lowest EN. Never put H in the center. Add single bonds."
                  ],
                  [
                    "3  Fill",
                    "Fill outer atoms first. H: 2; usually 8 for others. Put leftovers on the center."
                  ],
                  [
                    "4  Check",
                    "Total and shells correct. If not: recount electrons, check octet exceptions, and turn lone pairs into double or triple bonds if needed. Then check again."
                  ]
                ]
              },
              "notes": [
                {
                  "prompt": "Bond line =",
                  "answer": "2 shared electrons"
                },
                {
                  "prompt": "Lone pair =",
                  "answer": "2 unshared electrons"
                }
              ]
            },
            {
              "kind": "example",
              "title": "Slide 13 · Example: BF₃",
              "cues": [
                "Boron trifluoride",
                "Count, connect, fill and check"
              ],
              "problem": {
                "given": "BF₃, boron trifluoride.",
                "find": "the Lewis structure.",
                "answer": "Valence electrons = 3 + 3(7) = 24",
                "solution": [
                  "Count: 3 + 3(7) = 24",
                  "Connect: three B–F bonds use 6 electrons.",
                  "Fill: each F gets 3 lone pairs, 18 electrons.",
                  "Check: 6 bonding + 18 lone-pair electrons = 24."
                ],
                "workHeightIn": 2.0,
                "workLabel": "Draw it as shown on the slide"
              },
              "notes": [
                {
                  "prompt": "B has 6 electrons:",
                  "answer": "an octet exception"
                }
              ]
            }
          ]
        },
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slide 14 · Example: CO₂",
              "cues": [
                "Carbon dioxide"
              ],
              "problem": {
                "given": "CO₂, carbon dioxide.",
                "find": "the Lewis structure.",
                "answer": "Valence electrons = 4 + 2(6) = 16",
                "solution": [
                  "Count: 4 + 2(6) = 16",
                  "Connect: O–C–O uses 4 electrons.",
                  "Fill: the remaining 12 go on the oxygens. Carbon still has only 4.",
                  "Fix: share one lone pair from each O → O=C=O."
                ],
                "workHeightIn": 2.0,
                "workLabel": "Draw it as shown on the slide"
              },
              "notes": [
                {
                  "prompt": "O=C=O:",
                  "answer": "8 bonding electrons + 8 lone-pair electrons = 16. All atoms have 8."
                }
              ]
            },
            {
              "kind": "example",
              "title": "Slide 15 · Example: NH₃",
              "cues": [
                "Ammonia",
                "The leftover electrons"
              ],
              "problem": {
                "given": "NH₃, ammonia.",
                "find": "the Lewis structure.",
                "answer": "Valence electrons = 5 + 3(1) = 8",
                "solution": [
                  "Count: 5 + 3(1) = 8",
                  "Connect: three N–H bonds use 6 electrons. Each H now has 2.",
                  "Leftovers: 8 − 6 = 2. Both go on N as one lone pair."
                ],
                "workHeightIn": 2.0,
                "workLabel": "Draw it as shown on the slide"
              },
              "notes": [
                {
                  "prompt": "Check: N has",
                  "answer": "8 electrons around it. Each H has 2. Total used = 8."
                }
              ]
            }
          ]
        },
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slide 16 · Example: CH₂O",
              "cues": [
                "Formaldehyde",
                "H gets 2; C and O get 8"
              ],
              "problem": {
                "given": "CH₂O, formaldehyde.",
                "find": "the Lewis structure.",
                "answer": "Valence electrons = 4 + 2(1) + 6 = 12",
                "solution": [
                  "Count: 4 + 2(1) + 6 = 12",
                  "Connect: three single bonds use 6 electrons.",
                  "Fill: put 6 electrons on O. Carbon has only 6.",
                  "Fix: share one O lone pair to make C=O."
                ],
                "workHeightIn": 2.0,
                "workLabel": "Draw it as shown on the slide"
              },
              "notes": [
                {
                  "prompt": "Electron total:",
                  "answer": "C=O uses 4; two C–H bonds use 4; two O lone pairs use 4. Total: 12."
                }
              ]
            }
          ]
        }
      ]
