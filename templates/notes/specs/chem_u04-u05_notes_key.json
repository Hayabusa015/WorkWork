    {
      "code": "5.2",
      "title": "VSEPR Theory",
      "learningTarget": "I can state the VSEPR idea: electron groups repel and spread out around the central atom.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slides 10–11 · VSEPR theory",
              "cues": [
                "The VSEPR sequence",
                "The name, spelled out",
                "The idea"
              ],
              "notes": [
                {
                  "prompt": "Lewis structure →",
                  "answer": "electron groups → 3D shape"
                },
                {
                  "prompt": "VSEPR =",
                  "answer": "Valence Shell Electron Pair Repulsion"
                },
                {
                  "prompt": "The idea: electron groups",
                  "answer": "repel each other"
                },
                {
                  "prompt": "They spread out around the central atom",
                  "answer": "as far as possible"
                },
                {
                  "prompt": "Lewis structures come first. They show",
                  "answer": "bonds and lone pairs"
                },
                {
                  "prompt": "Count the groups to",
                  "answer": "predict shape"
