    {
      "code": "5.2",
      "title": "VSEPR Theory & Lewis Structures",
      "learningTarget": "I can state the VSEPR idea and draw a Lewis structure by counting, connecting, filling, and checking.",
      "pages": [
        {
          "rows": [
            {
              "title": "Slides 10–11 · VSEPR theory",
              "cues": [
                "S05.2"
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "VSEPR",
                  "answer": "Valence Shell Electron Pair Repulsion",
                  "inline": true
                },
                {
                  "prompt": "The sequence",
                  "answer": "Lewis structure → electron groups → 3D shape",
                  "inline": true
                },
                {
                  "prompt": "Electron groups",
                  "answer": "repel and spread out around the central atom",
                  "inline": true
                },
                {
                  "prompt": "Lewis structures show",
                  "answer": "bonds and lone pairs",
                  "inline": true
                },
                {
                  "prompt": "To predict shape",
                  "answer": "count the groups",
                  "inline": true
                },
                {
                  "prompt": "4 bonds, no lone pairs",
                  "answer": "tetrahedral",
                  "inline": true
                }
              ],
              "notesFirst": true
            },
            {
              "title": "Slide 12 · Drawing Lewis structures",
              "cues": [
                "S05.1",
                "Follow the steps, then check your electron count."
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "1  Count",
                  "answer": "add valence electrons; − charge: add, + charge: subtract",
                  "inline": true
                },
                {
                  "prompt": "2  Connect",
                  "answer": "center usually lowest EN, never H; add single bonds",
                  "inline": true
                },
                {
                  "prompt": "3  Fill",
                  "answer": "outer atoms first (H 2, usually 8); leftovers on center",
                  "inline": true
                },
                {
                  "prompt": "4  Check",
                  "answer": "total and shells correct",
                  "inline": true
                },
                {
                  "prompt": "If not, fix",
                  "answer": "recount, check exceptions, or make double/triple bonds",
                  "inline": true
                },
                {
                  "prompt": "Bond line / lone pair",
                  "answer": "2 shared / 2 unshared electrons",
                  "inline": true
                }
              ],
              "notesFirst": true
            },
            {
              "kind": "example",
              "title": "Slide 13 · Lewis structure: BF₃",
              "cues": [
                "S05.1"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "BF₃ valence electrons",
                  "answer": "3 + 3(7) = 24",
                  "inline": true
                },
                {
                  "prompt": "Boron ends with",
                  "answer": "6 electrons: an octet exception",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 13 · Draw the BF₃ Lewis structure",
                "workHeightIn": 1.7,
                "solution": [
                  "Connect: three B–F bonds use 6 electrons.",
                  "Fill: each F gets 3 lone pairs, 18 electrons.",
                  "Check: 6 bonding + 18 lone-pair electrons = 24."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s13_bf3.png"
              }
            }
          ]
        },
        {
          "rows": [
            {
              "kind": "example",
              "title": "Slide 14 · Lewis structure: CO₂",
              "cues": [
                "S05.1"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "CO₂ valence electrons",
                  "answer": "4 + 2(6) = 16",
                  "inline": true
                },
                {
                  "prompt": "Fix",
                  "answer": "share one lone pair from each O: O=C=O",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 14 · Draw the CO₂ Lewis structure",
                "workHeightIn": 1.7,
                "solution": [
                  "Connect: O–C–O uses 4 electrons.",
                  "Fill: the other 12 go on the oxygens. Carbon has only 4.",
                  "Fix: share one lone pair from each O → O=C=O.",
                  "Check: 8 bonding + 8 lone-pair electrons = 16. All atoms have 8."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s14_co2.png"
              }
            },
            {
              "kind": "example",
              "title": "Slide 15 · Lewis structure: NH₃",
              "cues": [
                "S05.1"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "NH₃ valence electrons",
                  "answer": "5 + 3(1) = 8",
                  "inline": true
                },
                {
                  "prompt": "Leftovers",
                  "answer": "8 − 6 = 2 electrons: one lone pair on N",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 15 · Draw the NH₃ Lewis structure",
                "workHeightIn": 1.7,
                "solution": [
                  "Connect: three N–H bonds use 6 electrons. Each H now has 2.",
                  "Leftovers: 8 − 6 = 2. Both go on N as one lone pair.",
                  "Check: N has 8 around it. Total used = 8."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s15_nh3.png"
              }
            },
            {
              "kind": "example",
              "title": "Slide 16 · Lewis structure: CH₂O",
              "cues": [
                "S05.1",
                "H gets 2; C and O get 8."
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "CH₂O valence electrons",
                  "answer": "4 + 2(1) + 6 = 12",
                  "inline": true
                },
                {
                  "prompt": "Fix",
                  "answer": "share one O lone pair to make C=O",
                  "inline": true
                }
              ],
              "problem": {
                "workLabel": "Slide 16 · Draw the CH₂O Lewis structure",
                "workHeightIn": 1.7,
                "solution": [
                  "Connect: three single bonds use 6 electrons.",
                  "Fill: 6 electrons on O. Carbon has only 6.",
                  "Fix: share one O lone pair → C=O.",
                  "Check: C=O 4 + two C–H 4 + two O lone pairs 4 = 12."
                ],
                "keyImage": "../assets/chem_u04-u05_key/s16_ch2o.png"
              }
            }
          ]
        }
      ]
    },
