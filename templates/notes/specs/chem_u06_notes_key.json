              "title": "Slides 5–6 · Naming molecular compounds",
              "cues": [
                "S06.1"
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "Rule 1 · first element",
                  "answer": "Keep its name. Prefix only for 2+ atoms (no mono-).",
                  "lines": 2
                },
                {
                  "prompt": "Rule 2 · second element",
                  "answer": "Use a prefix; change the ending to -ide.",
                  "lines": 1
                },
                {
                  "prompt": "Rule 3 · formula",
                  "answer": "Keep the actual atom counts.",
                  "lines": 1
                },
                {
                  "prompt": "Meaning of a subscript",
                  "answer": "Atoms of the element just before it.",
                  "lines": 1
                }
              ],
              "notesFirst": true
            },
