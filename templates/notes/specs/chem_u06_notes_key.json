                  "prompt": "Slide examples",
                  "answer": "CO = carbon monoxide · CO₂ = carbon dioxide",
                  "lines": 1
                },
                {
                  "prompt": "Prefixes and subscripts",
                  "answer": "Prefixes become subscripts in the formula.",
                  "lines": 1
