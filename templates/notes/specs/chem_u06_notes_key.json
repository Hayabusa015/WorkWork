        {
          "rows": [
            {
              "kind": "example",
              "title": "Slides 8–9 · How do you name N₂O₄?",
              "cues": [
                "S06.1"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "Prefix rule",
                  "answer": "Skip mono- on the first element; prefix the second.",
                  "lines": 2
                },
                {
                  "prompt": "No subscript means",
                  "answer": "One atom. Use mono- only on the second element.",
                  "lines": 1
                }
              ],
              "problem": {
                "workLabel": "Slides 8–9 · Name N₂O₄: the prefix for each element. Then name CO and PCl₃.",
                "workHeightIn": 1.5,
                "solution": [
                  "N₂ → di- + nitrogen = dinitrogen",
                  "O₄ → tetra- + oxide = tetroxide → dinitrogen tetroxide",
                  "CO = carbon monoxide · PCl₃ = phosphorus trichloride"
                ]
              }
            },
            {
              "kind": "example",
              "title": "Slides 10–11 · Writing molecular formulas",
              "cues": [
                "S06.1"
              ],
              "extraNotes": false,
              "notesFirst": true,
              "notes": [
                {
                  "prompt": "From name to formula",
                  "answer": "Prefixes count actual atoms; keep those counts.",
                  "lines": 1
                },
                {
                  "prompt": "Steps",
                  "answer": "Write the symbols in order; each prefix gives a subscript.",
                  "lines": 2
                }
              ],
              "problem": {
                "workLabel": "Slides 10–11 · Write the formulas: dinitrogen pentoxide, sulfur hexafluoride",
                "workHeightIn": 1.4,
                "solution": [
                  "di- = 2, penta- = 5 → N₂O₅",
                  "sulfur = 1, hexa- = 6 → SF₆"
                ]
              }
            },
            {
              "title": "Slide 12 · Why N₂O₄ stays N₂O₄",
              "cues": [
                "S06.1"
              ],
              "noWorkBox": true,
              "extraNotes": false,
              "notes": [
                {
                  "prompt": "Conclusion",
                  "answer": "N₂O₄ and NO₂ are different molecules: never reduce a molecular formula.",
                  "lines": 2
                }
              ],
              "table": {
                "headers": [
                  "Formula",
                  "Name",
                  "Atoms in one molecule"
                ],
                "rows": [
                  [
                    "N₂O₄",
                    "dinitrogen tetroxide",
                    "2 N, 4 O"
                  ],
                  [
                    "NO₂",
                    "nitrogen dioxide",
                    "1 N, 2 O"
                  ]
                ],
                "widths": [
