            {
              "row": [
                "Δy = v_{iy} t + ",
                {
                  "frac": [
                    "1",
                    "2"
                  ]
                },
                " a_{y} t^{2}"
              ]
            },
            {
              "mistake": [
                "+18 = 9.298 t − 4.9 t^{2}"
              ],
              "note": "the water is below the launch, so Δy is negative"
