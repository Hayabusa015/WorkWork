            {
              "row": [
                "−18 = (9.298) t + ",
                {
                  "frac": [
                    "1",
                    "2"
                  ]
                },
                "(−9.8) t^{2}"
              ]
            },
            {
              "row": [
                "4.9 t^{2} − 9.298 t − 18 = 0"
              ]
            },
            {
              "row": [
                "t =",
                {
                  "frac": [
                    "9.298 ± √((9.298)^{2} + 4(4.9)(18))",
                    "2(4.9)"
                  ]
                }
              ]
            },
            {
              "row": [
                "t =",
                {
                  "frac": [
                    "9.298 ± √439.2",
                    "9.8"
                  ]
                },
                "= 3.09 s  or  −1.19 s"
              ]
            },
            {
              "say": "The negative time is before the launch, so it is thrown out.",
              "ink": "pen"
            },
            {
              "answer": [
                "t ="
