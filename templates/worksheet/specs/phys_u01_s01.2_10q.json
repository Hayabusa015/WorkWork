          "sketch": {"scene": "linear", "find": "a (m/s^{2})", "t": "4 s", "lanes": [{"name": "The Flash", "v0": "30 m/s", "v": "10 m/s", "a": "?", "a_dir": -1}]},
          "steps": [
            {"row": ["v = v_{0} + at"], "note": "subtract v_{0} from both sides"},
            {"row": ["v − v_{0} = at"], "note": "divide both sides by t"},
