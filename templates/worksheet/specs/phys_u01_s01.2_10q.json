          "selfCheck": "[  17 m/s  ]",
          "solution": "v = v0 + at = 5 m/s + (3 m/s²)(4 s) = 17 m/s.",
          "finalAnswer": "17 m/s",
          "sketch": {"scene": "linear", "ground": false, "find": "v (m/s)", "t": "4 s", "lanes": [{"name": "Iron Man", "v0": "5 m/s", "v": "?", "a": "3 m/s^{2}"}]},
          "steps": [
            {"row": ["v = v_{0} + at"]},
            {"row": ["v = 5 m/s + (3 m/s^{2})(4 s)"]},
            {"row": ["v = 5 m/s + 12 m/s"]},
            {"answer": ["v ="], "value": "17 m/s"}
          ]
        },
